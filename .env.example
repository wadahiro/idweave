# Copy to .env and adjust to point at your target stack.
# These defaults match the local docker-compose dev stack.

# The bundled example examples/midpoint-basic/ serves all midPoint majors from ONE
# scenario tree; the Makefile selects the example with EXAMPLE (default midpoint-basic)
# and, for midpoint-basic, the major with VER (e.g. `make up VER=4.8`), exporting the
# dirs + endpoint below (MP_VERSION/EXPECTED_VERSION pick the GUI page objects + the
# expected/<ver>/ tree). Set these directly only off the Makefile.
# Per-version host ports: 4.10->8080, 4.8->8108, 4.4->8104, 4.0->8100.
MIDPOINT_BASE_URL=http://localhost:8080/midpoint
MIDPOINT_USER=administrator
MIDPOINT_PASSWORD=Test5ecr3t

# Suite location. Defaults point at the bundled midpoint-basic example (4.10);
# switch the version dir or point at your private suite (testdata/...).
CONFIG_DIR=examples/midpoint-basic/midpoint-config/4.10
SCENARIOS_DIR=examples/midpoint-basic/scenarios
# Major version: selects GUI page objects + cache-clear (suite `version: ${MP_VERSION}`)
# and the expected/<ver>/ tree.
MP_VERSION=4.10
EXPECTED_VERSION=4.10

# Host dir bind-mounted into the midPoint container (where the CSV connector
# reads/writes) — shared across versions (external-system data). Resource OIDs and
# file/column specs are SUITE data, declared in <SCENARIOS_DIR>/suite.yaml — not env.
CSV_HOST_DIR=examples/midpoint-basic/infra/data/csv

# GUI-driven steps (request-ui/approve-ui/login-ui). GUI_BASE_URL defaults to
# MIDPOINT_BASE_URL; set it when the GUI is a different origin than REST (e.g.
# behind an SSO front-end). GUI_PASSWORD is the shared password UI principals log
# in with. GUI_HEADLESS=false to watch the browser. GUI_IGNORE_HTTPS_ERRORS=true
# accepts a self-signed cert (typical for an SSO dev FQDN). The login provider
# (native vs Keycloak SSO) is SUITE data — `gui.auth` in <SCENARIOS_DIR>/suite.yaml.
# GUI_BASE_URL=https://idm-dev.example.com/midpoint
GUI_PASSWORD=Test1234!
# GUI_HEADLESS=false
# GUI_IGNORE_HTTPS_ERRORS=true

# Bounded polling (no sleeps).
POLL_TIMEOUT_MS=90000
POLL_INTERVAL_MS=1000

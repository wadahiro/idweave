# Refuse to install under a Node that doesn't satisfy package.json `engines`
# (>=24) — surfaces a version mismatch at install time instead of a confusing
# runtime error.
engine-strict=true

# Keep caret (^) ranges in package.json; package-lock.json (with integrity
# hashes) is the reproducibility/integrity anchor, and CI installs with `npm ci`.
save-exact=false

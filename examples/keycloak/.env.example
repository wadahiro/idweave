# Env for the independent Keycloak example. The `keycloak-*` make targets set these
# themselves (target-specific exports); this file documents them for running the
# scenarios (or the snapshot CLI) directly.

# Admin service-account connection (client_credentials) the keycloak system + the
# afterRestore cache-clear use. Matches the seeded realm (infra/realm/*.json).
KEYCLOAK_ADMIN_URL=http://localhost:8090
KEYCLOAK_ADMIN_REALM=idweave
KEYCLOAK_ADMIN_CLIENT_ID=idweave-admin
KEYCLOAK_ADMIN_SECRET=idweave-admin-secret

# Snapshot CLI wiring (drives docker for THIS compose project).
COMPOSE_PROJECT=idweave-keycloak
COMPOSE_FILES=examples/keycloak/infra/docker-compose.yml
SCENARIOS_DIR=examples/keycloak/scenarios
SNAPSHOT_DIR=examples/keycloak/infra/snapshots

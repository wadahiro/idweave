<!--
  Registered import task for the Org CSV source.

  Demonstrates testing a DEPLOYED import task object rather than midPoint's
  generic /resources/{oid}/import endpoint: the suite wires this task's OID as
  the org source's importTaskOid, so an `import` step on `source: org` runs THIS
  task (run-now) and the harness verifies the configured task actually works.
  (The hr source has no importTaskOid, so it still uses the generic endpoint —
  the example exercises both paths.)

  Single-run runnable (like the recon task): goes `closed` after each run and is
  re-run on demand with run-now.
-->
<task xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
      oid="c5777777-7777-7777-7777-777777777777">
    <name>Org Import</name>
    <description>On-demand import of the Org CSV source. Triggered by the harness via run-now.</description>
    <executionState>runnable</executionState>
    <activity>
        <work>
            <import>
                <resourceObjects>
                    <resourceRef oid="c5666666-6666-6666-6666-666666666666"/>
                    <kind>account</kind>
                    <intent>default</intent>
                </resourceObjects>
            </import>
        </work>
    </activity>
</task>

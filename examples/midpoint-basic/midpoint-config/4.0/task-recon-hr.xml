<!--
  Our deployment config under test: a reconciliation task for the HR source.

  Reconciliation (unlike import) compares the source against midPoint's shadows
  and detects DELETED source accounts, driving the `deleted` synchronization
  reaction (deleteFocus) — i.e. the Leaver/offboarding path. Registered with a
  fixed OID so the harness can "run now" it on demand (POST /tasks/{oid}/run).

  4.0 NOTE: the activity-based task model (activity/work, executionState) is 4.4+.
  4.0 uses the classic task schema: executionStatus, a handlerUri for the
  reconciliation handler, objectRef to the resource, and category. (Keep literal
  angle-bracket tags out of this LEADING comment — the import-config CLI reads the
  first <tag> it sees to type the object, and a tag in a pre-root comment fools it.)
-->
<task xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
      xmlns:ri="http://midpoint.evolveum.com/xml/ns/public/resource/instance-3"
      oid="c5444444-4444-4444-4444-444444444444">
    <name>Recon HR Source</name>
    <ownerRef oid="00000000-0000-0000-0000-000000000002" type="UserType"/>
    <executionStatus>runnable</executionStatus>
    <category>Reconciliation</category>
    <handlerUri>http://midpoint.evolveum.com/xml/ns/public/model/synchronization/task/reconciliation/handler-3</handlerUri>
    <objectRef oid="c5111111-1111-1111-1111-111111111111" type="ResourceType"/>
    <!-- 4.0 reconciliation REQUIRES an explicit object class ("Reconciliation
         without an object class specification is not supported"). -->
    <extension xmlns:mext="http://midpoint.evolveum.com/xml/ns/public/model/extension-3">
        <mext:objectclass>ri:AccountObjectClass</mext:objectclass>
    </extension>
    <recurrence>single</recurrence>
</task>
